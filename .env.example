# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- AWS / S3 (production storage backend) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# Storage root override. Leave unset to use the value in pipeline_config.yaml
# (./data for local dev). In prod set to your S3 location, e.g.:
#   STORAGE_ROOT=s3://my-bucket/sneaker-intel
STORAGE_ROOT=

# --- MLflow (Phase 4+) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- sneaker-intel Postgres source (Phase 1, OPTIONAL) ---
# If set, the ingest stage does a real export from the live warehouse. If unset,
# the pipeline runs on synthetic fixtures (data/fixtures/) -- the default dev/CI
# path. The pipeline is fully runnable without this.
#   SNEAKER_INTEL_DSN=postgresql://user:pass@host:5432/sneaker_intel
SNEAKER_INTEL_DSN=
