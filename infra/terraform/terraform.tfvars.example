# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

aws_region  = "us-east-1"
project     = "sneaker-ml"

# Must be globally unique across all of AWS.
bucket_name = "sneaker-ml-lake-CHANGE-ME"

