# Secrets -- never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local pipeline data + model artifacts (regenerated from fixtures)
data/raw/
data/features/
data/validated/
data/models/
data/failures/
*.parquet
*.pt
mlruns/
mlartifacts/
mlflow.db
ray_results/

# Allow the committed fixtures directory to exist even though *.parquet is
# ignored above -- fixtures are regenerated by generate_fixtures.py, so we keep
# the folder but not its contents.
!data/fixtures/

# Airflow local state
airflow.db
airflow.cfg
logs/
standalone_admin_password.txt

# OS / editor
.DS_Store
.idea/
.vscode/
